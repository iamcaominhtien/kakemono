<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.iamcaominhtien</groupId>
    <artifactId>kakemono-parent</artifactId>
    <version>0.20.0</version>
  </parent>
  <artifactId>kakemono-langchain4j</artifactId>
  <name>kakemono for LangChain4j</name>
  <description>A LangChain4j DocumentParser and segments from kakemono: PDF papers, Word documents, workbooks, EPUB books and web pages as Markdown, or as chunks with their section and pages</description>

  <dependencies>
    <dependency>
      <groupId>io.github.iamcaominhtien</groupId>
      <artifactId>kakemono</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-core</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.iamcaominhtien.kakemono.langchain4j</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
