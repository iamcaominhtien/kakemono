{
  "name": "@kakemono/wasm",
  "version": "0.20.0",
  "description": "kakemono in WebAssembly: PDF papers, Word documents, Excel workbooks, EPUB books and web pages to Markdown, HTML, Word, EPUB and chunks for RAG, in the browser (experimental)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamcaominhtien/kakemono.git",
    "directory": "bindings/wasm"
  },
  "keywords": [
    "pdf",
    "docx",
    "xlsx",
    "epub",
    "markdown",
    "wasm",
    "webassembly",
    "browser",
    "rag"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./pkg/node/index.d.mts",
          "default": "./pkg/node/index.mjs"
        },
        "require": {
          "types": "./pkg/node/kakemono_wasm.d.ts",
          "default": "./pkg/node/kakemono_wasm.js"
        }
      },
      "types": "./pkg/web/kakemono_wasm.d.ts",
      "default": "./pkg/web/kakemono_wasm.js"
    }
  },
  "types": "./pkg/web/kakemono_wasm.d.ts",
  "files": [
    "pkg/node",
    "pkg/web",
    "README.md"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "node --test test/*.test.mjs"
  }
}
